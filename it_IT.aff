PFX DU 0 un' [aeiouàèéìòùh]

# ri- (iterativo) su verbi regolari
PFX PR Y 1
PFX PR 0 ri/V1V2V3VIVAVBVC .

# s- (privativo/inespansivo) — NB: su verbi può sovragenerare
PFX PS Y 2
PFX PS 0 s/V1V2V3VIVAVBVC .
PFX PS 0 s/A1A2 .

# dis- — NB: su verbi può sovragenerare
PFX PD Y 1
PFX PD 0 dis/A1A2V1V2V3VIVAVBVC .

# in-/im-/il-/ir- (negazione) su aggettivi
