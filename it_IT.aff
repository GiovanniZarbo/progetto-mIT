# =====================================================================
#  it_IT.aff  —  Dizionario ortografico italiano per Hunspell
#  Licenza: MIT (vedi LICENSE)
#
#  FLAG long  =>  ogni flag è ESATTAMENTE 2 caratteri.
#
#  Sezione 0 : direttive generali
#  Sezione 1 : sostantivi
#  Sezione 2 : aggettivi
#  Sezione 3 : verbi regolari
#  Sezione 4 : verbi irregolari
#  Sezione 5 : alterati (da concatenare al flag del sostantivo)
#  Sezione 6 : prefissi
#
#  NOTA sul modello SFX: la condizione (4° campo) viene valutata sulla
#  parola PRIMA dello stripping. Lo strip rimuove la parte finale
#  indicata e l'add vi riaggiunge la nuova desinenza.
#  "0" nello strip o nell'add significa "niente".
# =====================================================================

SET UTF-8
FLAG long

# Caratteri considerati parte della parola (apostrofo + vocali accentate)
WORDCHARS àèéìòùÀÈÉÌÒÙ'

# Caratteri simili per i suggerimenti (raggruppamento accenti)
MAP 7
MAP aàáä
MAP eèéë
MAP iìíï
MAP oòóö
MAP uùúü
MAP cç
MAP nñ

# Ordine di frequenza (per i suggerimenti)
TRY eaiotlnsrcdmupgvbfhqzwyxjkàèéìòù

# Normalizza apostrofi tipografici in input
ICONV 3
ICONV ’ '
ICONV ` '
ICONV ´ '

# Correzioni di tastiera comuni (REP)
REP 18
REP e' è
REP a' à
REP o' ò
REP u' ù
REP i' ì
REP E' È
REP A' À
REP O' Ò
REP U' Ù
REP I' Ì
REP puo può
REP perche perché
REP piu più
REP gia già
REP cosi così
REP cioe cioè
REP nè né
REP poiche poiché

# =====================================================================
# 1. SOSTANTIVI
# =====================================================================

# -o regolare : libro -> libri
SFX NO Y 1
SFX NO o i .

# -a regolare con raddoppiamento h davanti a c/g : casa -> case, amica -> amiche
SFX NA Y 2
SFX NA a e [^cg]a
SFX NA a he [cg]a

# -e regolare : fiume -> fiumi, nome -> nomi
SFX NE Y 1
SFX NE e i .

# -a neutro (greco -ma) : problema -> problemi
SFX MA Y 1
SFX MA a i .

# -o irregolare in -i : mano -> mani
SFX FO Y 1
SFX FO o i .

# -io -> -i : dizionario -> dizionari, bacio -> baci
SFX NU Y 1
SFX NU io i .

# -co/-go -> -chi/-che : lago -> laghi, parco -> parchi
SFX NK Y 1
SFX NK o hi [cg]o

# -co/-go -> -i (medico -> medici)
SFX NM Y 1
SFX NM o i [cg]o

# -cia dopo vocale -> -cie : camicia -> camicie, farmacia -> farmacie, bugia -> bugie
SFX NC Y 1
SFX NC ia ie [aeiou][cg]ia

# -cia dopo consonante -> -ce (in -ggia/-scia) : pioggia -> piogge, provincia -> province
SFX NG Y 1
SFX NG ia e [^aeiou][cg]ia

# -o invariante nel femminile : braccio -> braccia, uovo -> uova, dito -> dita
SFX NV Y 1
SFX NV o a .

# -a invariante nel tema (m/f) : collega -> colleghi/colleghe, cantante -> cantanti/canti
SFX NW Y 4
SFX NW a hi [cg]a
SFX NW a he [cg]a
SFX NW a i [^cg]a
SFX NW a e [^cg]a

# -a m/f separato : giornalista -> giornalisti/giornaliste
SFX NZ Y 2
SFX NZ a i .
SFX NZ a e .

# -e (carnefice, senatrice) -> -i
SFX NX Y 1
SFX NX e i .

# -trice : attrice -> attrici, direttrice -> direttrici
SFX NY Y 1
SFX NY ce ci .

# invariabile : re -> re
SFX NI Y 1
SFX NI 0 0 .

# =====================================================================
# 2. AGGETTIVI
# =====================================================================

# -o regolare : buono -> buona/buoni/buone
SFX A1 Y 3
SFX A1 o a .
SFX A1 o i .
SFX A1 o e .

# -e regolare : forte -> forti, veloce -> veloci
SFX A2 Y 1
SFX A2 e i .

# -co : bianco -> bianca/bianchi/bianche
SFX AK Y 3
SFX AK o a co
SFX AK o hi co
SFX AK o he co

# -go : largo -> larga/larghi/larghe
SFX AG Y 3
SFX AG o a go
SFX AG o hi go
SFX AG o he go

# -co irregolare nel femminile : frenetico -> frenetica/frenetici/frenetiche
SFX AM Y 3
SFX AM o a co
SFX AM o i co
SFX AM o he co

# bello -> bella/belli/belle e bel/bei/begli
SFX AB Y 6
SFX AB o a .
SFX AB o e .
SFX AB o i .
SFX AB ello el o
SFX AB ello ei o
SFX AB ello egli o

# invariabile : blu -> blu
SFX AI Y 1
SFX AI 0 0 .

# superlativo assoluto : alto -> altissimo/altissima/altissimi/altissime
SFX ST Y 8
SFX ST o issimo o
SFX ST o issima o
SFX ST o issimi o
SFX ST o issime o
SFX ST e issimo e
SFX ST e issima e
SFX ST e issimi e
SFX ST e issime e

# avverbio in -mente : veloce -> velocemente, lento -> lentamente
SFX ME Y 2
SFX ME 0 mente e
SFX ME o amente o

